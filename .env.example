# Copia este archivo a .env para cambiar credenciales (.env no se sube a git).
#   cp .env.example .env
# Sin .env, docker-compose.yml usa estos mismos valores por defecto.
#
# Si cambias las de PostgreSQL con los volúmenes ya creados, PostgreSQL NO cambia
# la contraseña de un usuario existente: borra el volumen (docker compose down -v)
# o cámbiala con ALTER USER.
#
# Los scripts Python del devcontainer (generator.py, api.py) leen las mismas
# variables del entorno de la terminal: si las cambias, expórtalas también:
#   set -a; source .env; set +a

POSTGRES_DB=bigdata
POSTGRES_USER=bigdata_user
POSTGRES_PASSWORD=bigdata_pass

GRAFANA_ADMIN_PASSWORD=admin
# Admin: cualquiera puede editar sin login (cómodo en clase). Viewer: solo lectura.
GRAFANA_ANONYMOUS_ROLE=Admin
